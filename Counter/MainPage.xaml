<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Counter.MainPage">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="20">
            <Frame Padding="15" CornerRadius="10">
                <VerticalStackLayout Spacing="10">
                    <Label Text="Panel tworzenia licznika" FontAttributes="Bold" FontSize="18"/>

                    <Entry x:Name="NameInput" 
                           Placeholder="Wpisz nazwę licznika" />

                    <Entry x:Name="StartInput" 
                           Placeholder="Wartość początkowa" 
                           Keyboard="Numeric" 
                           Text="0" />
                    
                    <Button Text="Dodaj nowy licznik" 
                            Clicked="OnAddClicked" />
                </VerticalStackLayout>
            </Frame>

            <VerticalStackLayout x:Name="CountersContainer" Spacing="15" />

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>